{
  "figures": [
    {
      "key": "decision_workflow",
      "dataset": "M5 + RETAILNET",
      "title": "From information to an approved order",
      "caption": "Workflow schematic used to explain both studies. The language model interprets bounded inputs; numerical tools calculate orders and independent checks control execution. This is not an additional experimental result.",
      "path": "figures/decision_workflow.png",
      "sha256": "c01125da4521ea7c442215683421a9cc84b55067fab4ec96516092e9ed317476"
    },
    {
      "key": "evidence_layers",
      "dataset": "M5 + RETAILNET",
      "title": "Three kinds of information",
      "caption": "Evidence classification. These categories must be distinguished even when they appear together in a planning record. Natural lost demand is not observed.",
      "path": "figures/evidence_layers.png",
      "sha256": "417b3c628c6d74068f0e3f3cd3c1a48d0f1c6946b19108620c406e10715bbf75"
    },
    {
      "key": "panel_profiles",
      "dataset": "M5 + RETAILNET",
      "title": "The computational panels",
      "caption": "Both panels have thirty store\u2013product series. M5 has three selected food products across ten stores; RetailNet has twenty-six products and twenty-nine stores. Full-release validation is separate from panel performance evaluation.",
      "path": "figures/panel_profiles.png",
      "sha256": "c648bbf4af595a2070d96c7f08424d472a3cdcb85717ec473a2b719acf7c9eec"
    },
    {
      "key": "retailnet_availability",
      "dataset": "RETAILNET",
      "title": "Sales were often availability-constrained",
      "caption": "Complete pinned release: training and evaluation files. Hourly and daily percentages use different denominators. Operating hours are 06:00\u201321:00. These observations identify availability conditions; they do not quantify true lost demand.",
      "path": "figures/retailnet_availability.png",
      "sha256": "30780ce9d657b915b6b348976863ebc2780ec3e5c1c8b2e65e9d8ebf10257ce4"
    },
    {
      "key": "study_map",
      "dataset": "M5 + RETAILNET",
      "title": "How the experiments answer different questions",
      "caption": "Study map. M5 and RetailNet include numerical and matched-reader work. Separate forecasting and fresh-product calculator analyses use RetailNet and contain no language-model calls.",
      "path": "figures/study_map.png",
      "sha256": "c72fdb1def3d462f2ccfcbfcc25792cc9d00be08df19bf26aa73b42761c3323e"
    },
    {
      "key": "m5_repair",
      "dataset": "M5",
      "title": "Verified repair under an inventory-field fault",
      "caption": "Improved M5 pilot; thirty series, fourteen days, two shared seeds. Simulated cost uses the M5 study monetary conventions. The matched rule-based reader achieved the same results.",
      "path": "figures/m5_repair.png",
      "sha256": "4f6d96609d87d2986c36ce7d36c732935eec73cb9d2c459a6e313537d2f14329"
    },
    {
      "key": "retailnet_repair",
      "dataset": "RETAILNET",
      "title": "Verified repair under an inventory-field fault",
      "caption": "Exploratory calibrated follow-up; thirty series, seven days, thirty seeds. Reused holdout. Cost is an index, not retailer currency. The matched rule-based reader achieved the same results.",
      "path": "figures/retailnet_repair.png",
      "sha256": "416fcf8cfc6a4f6c0a4cdb7acb59465b1244e498fe4b5b8ec8b9ccd080f267a3"
    },
    {
      "key": "m5_reader_parity",
      "dataset": "M5",
      "title": "Reader comparisons lie on the equality line",
      "caption": "Improved pilot: sixteen matched scenario/seed/recovery comparisons. Some points overlap because outcomes are equal. Exact daily actions also matched; equal cost and service are not evidence of incremental LLM superiority.",
      "path": "figures/m5_reader_parity.png",
      "sha256": "cc28adb9f63f78b6668acf74375872a67cf39acd1c06e36bf9459349dfe63d8a"
    },
    {
      "key": "retailnet_forecast",
      "dataset": "RETAILNET",
      "title": "Unadjusted-sales LightGBM led the main forecast test",
      "caption": "Official evaluation, 114 fully stocked panel-days out of 210. Lower WAPE is better. Models were selected before evaluation unsealing. These are numerical methods, not LLM forecasts.",
      "path": "figures/retailnet_forecast.png",
      "sha256": "6d81a45e895f3400e488755c5ab6ccd88591d2130aad2425207353957aa35228"
    },
    {
      "key": "retailnet_cap_transfer",
      "dataset": "RETAILNET",
      "title": "Approval policy had to fit the new setting",
      "caption": "Matched cap transition at the original two seeds, 13 and 29, for the LLM-with-repair configuration; the reader counterpart is equal. Original cap 1,500, training-selected cap 1,850. Follow-up is exploratory and reuses the holdout.",
      "path": "figures/retailnet_cap_transfer.png",
      "sha256": "2781a296b4bf1ba30ec3a7ed5948d78adf48e568990eb3f08f804656ae4a5669"
    },
    {
      "key": "retailnet_seed_variation",
      "dataset": "RETAILNET",
      "title": "The repair benefit varied across seeds",
      "caption": "Exploratory follow-up, inventory-field fault, thirty paired seeds. Cost decreased in 26/30 seeds; orange points show the four adverse cost outcomes. Fill increased in 30/30. Simulation seeds are not independent stores or historical weeks.",
      "path": "figures/retailnet_seed_variation.png",
      "sha256": "5f2736985990ad2002e693ccda075bbc972c47282c90838a8a8758e00bf91db7"
    },
    {
      "key": "retailnet_conventional_comparison",
      "dataset": "RETAILNET",
      "title": "Lower cost came with lower service",
      "caption": "Normal scenario, the same thirty seeds and seven-day horizon. Conventional optimizer: primary numerical study. Approval workflow: exploratory calibrated follow-up. Both had zero actual committed-rule violations. No overall-winner claim is supported.",
      "path": "figures/retailnet_conventional_comparison.png",
      "sha256": "d169381ec275c0c987d6f383d24b8e46be24ad7b50e3ad4d3287d08305ed12dc"
    },
    {
      "key": "retailnet_perishability",
      "dataset": "RETAILNET",
      "title": "Fresh-product service and expiry must be read together",
      "caption": "Separate age-aware calculator analysis, thirty seeds per cell, assumed demand multiplier 1.25. Waste denominator is opening stock plus receipts. Shelf lives are hypothetical. No LLM calls; units and supply differ from the main optimizer study.",
      "path": "figures/retailnet_perishability.png",
      "sha256": "6b7b0d5155cf67408bed4ecae8713662122a6ad8f1b70290f69fc14e8ad26c1e"
    },
    {
      "key": "retailnet_stockout_rule",
      "dataset": "RETAILNET",
      "title": "A valid stockout flag should inform the decision",
      "caption": "Sixty separate calculator runs, thirty shared seeds, three-day life and assumed demand multiplier 1.25. Hold-on-stockout is a deliberately defective ablation, not a strong competitor. Neither configuration uses an LLM.",
      "path": "figures/retailnet_stockout_rule.png",
      "sha256": "27f3d58aeebc4384feab383a64805d92e01f9c24575ead4eaa24f4f07626289f"
    },
    {
      "key": "cross_dataset_repair",
      "dataset": "M5 + RETAILNET",
      "title": "Within-setting repair effects",
      "caption": "Descriptive comparison, inventory-field-fault scenario. M5: improved pilot. RetailNet original: fixed-cap primary study. RetailNet calibrated: exploratory reused-holdout follow-up. Economic scales and horizons differ; the reader achieves the same effects as the LLM.",
      "path": "figures/cross_dataset_repair.png",
      "sha256": "4305ccfd5a744a03cd2a4a985ee9e6491baae8a72f35d1f1220ee2faf271820e"
    },
    {
      "key": "recovery_choices",
      "dataset": "M5 + RETAILNET",
      "title": "Tools contained inappropriate recovery requests",
      "caption": "Request-level observations, shown separately by study. All stale-source repair requests were refused. Cached reader imports are not additional model judgements. Correct formatting does not establish correct tool choice.",
      "path": "figures/recovery_choices.png",
      "sha256": "2cdfee398d79e984117eb5792a0a06067d1c8a799379dcb5de9137695e339b17"
    },
    {
      "key": "adoption_path",
      "dataset": "M5 + RETAILNET",
      "title": "A proposed route to operational testing",
      "caption": "Managerial recommendation derived from the findings. This operational pilot was not conducted as part of the dissertation and does not represent an observed deployment result.",
