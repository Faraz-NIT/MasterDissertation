    "title": "Declared simulation assumptions; common across empirical stages",
    "headers": [
      "Element",
      "Setting and interpretation"
    ],
    "rows": [
      [
        "Starting stock",
        "ceil(3 × past-56-day mean); zero initial pipeline"
      ],
      [
        "Synthetic suppliers",
        "Three groups; ten series per group; current daily terms supplied before ordering"
      ],
      [
        "Routine carton / minimum order",
        "Cartons of 2, 4 and 6; minimum nonzero line twice its carton size"
      ],
      [
        "Routine lead times",
        "1, 2 and 2 days for the three supplier groups"
      ],
      [
        "Daily budget and dispatch limits",
        "Training-derived scale 2.8 × historical mean; announced daily variation of up to ±8%"
      ],
      [
        "Delivery opportunities",
        "2% cancellation; 10% draw for 80% fill; 10% draw for one extra delivery day"
      ],
      [
        "Promotion",
        "Announced 30% increase in demand proxy and forecast from the third day"
      ],
      [
        "Supplier disruption",
        "From the third day: carton/MOQ ×2, lead time +1 day, capacity ×0.7, with a minimum feasible limit"
      ],
      [
        "Stock life",
        "M5: no expiry within the horizon; RetailNet: hypothetical three-day FIFO"
      ],
      [
        "Declared priorities",
        "Balanced: safety factor 1.28; active promotion: service-first factor 1.65"
      ],
      [
        "Hard constraints",
        "Nonnegative quantities, carton multiples, minimum line, supplier capacity and daily budget"
      ],
      [
        "Inventory-record errors",
        "None injected; no inventory repair or sales-recovery mechanism"
      ]
