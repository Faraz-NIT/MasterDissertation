  "verbatim_blocks": [
    {
      "key": "reproduction",
      "text": ".venv/bin/python -m pip install -r requirements.txt\n.venv/bin/python tools/verify_bundle.py\n.venv/bin/python -I -m pytest -q tests\n.venv/bin/python tools/audit_saved_results.py"
    },
    {
      "key": "prompt_supplier",
      "text": "You are the supplier-information agent. Read the current supplier message. Extract exactly one rule for each of S1, S2 and S3, and the daily budget. Copy every number exactly; pack is carton size, moq is minimum order, lead_days is delivery time, capacity is daily dispatch limit. Meaning matters, not the order of numbers in the sentence: a dispatch limit is capacity, and cartons of N means pack=N. Do not swap these fields. Use the current rules only. Return only the JSON object."
    },
    {
      "key": "example_supplier_1",
      "text": "For S1, dispatch no more than 97 units today; allow 2 days for delivery. Minimum order 6 units; cartons of 3. For S2, cartons contain 4 units, minimum order 8, delivery 1 day, dispatch limit 88. S3 has dispatch limit 120, delivery 3 days, minimum order 12, carton size 6. Daily spending budget 250."
    },
    {
      "key": "example_supplier_2",
      "text": "{\"rules\": [{\"supplier\": \"S1\", \"pack\": 3, \"moq\": 6, \"lead_days\": 2, \"capacity\": 97}, {\"supplier\": \"S2\", \"pack\": 4, \"moq\": 8, \"lead_days\": 1, \"capacity\": 88}, {\"supplier\": \"S3\", \"pack\": 6, \"moq\": 12, \"lead_days\": 3, \"capacity\": 120}], \"budget\": 250}"
    },
    {
      "key": "prompt_planner",
      "text": "You are the replenishment coordination agent. Numerical tools calculate quantities. Request constrained_order. Select balanced for routine trading and supplier disruption. Select service_first for an active announced promotion when availability is the priority. Do not estimate quantities yourself. Return only JSON."
    },
    {
      "key": "prompt_critic",
      "text": "You are the independent review agent. Approve only when source verification, tool routing, solver feasibility, and every listed action check pass. Hold if any check fails or is unknown. Never override a failed check. Return only JSON."
    },
    {
      "key": "example_critic_1",
      "text": "{\"source_verification\":\"pass\",\"tool_routing\":\"pass\",\"solver_feasible\":true,\"action_checks\":{\"pack\":\"pass\",\"moq\":\"pass\",\"capacity\":\"pass\",\"budget\":\"fail\"}}"
    },
    {
      "key": "example_critic_2",
      "text": "{\"verdict\":\"hold\"}"
    },
    {
      "key": "example_critic_3",
      "text": "{\"source_verification\":\"pass\",\"tool_routing\":\"pass\",\"solver_feasible\":true,\"action_checks\":{\"pack\":\"pass\",\"moq\":\"pass\",\"capacity\":\"pass\",\"budget\":\"pass\"}}"
    },
    {
      "key": "example_critic_4",
      "text": "{\"verdict\":\"approve\"}"
    },
    {
      "key": "message_0",
      "text": "Current supplier agreement for decision day 0. All quantities are study units.\nS1 sells cartons of 2 units. The minimum order is 4 units. Delivery takes 1 days. Daily dispatch is limited to 100 units.\nS2 sells cartons of 4 units. The minimum order is 8 units. Delivery takes 2 days. Daily dispatch is limited to 120 units.\nS3 sells cartons of 6 units. The minimum order is 12 units. Delivery takes 2 days. Daily dispatch is limited to 150 units.\nThe current daily spending budget is 250 cost-index units. Each purchased unit costs one cost-index unit."
    },
    {
      "key": "message_1",
      "text": "Current supplier agreement for decision day 0. All quantities are study units.\nFor S1, dispatch no more than 100 units today; allow 1 days for delivery. The order must contain at least 4 units, supplied in cartons of 2.\nFor S2, dispatch no more than 120 units today; allow 2 days for delivery. The order must contain at least 8 units, supplied in cartons of 4.\nFor S3, dispatch no more than 150 units today; allow 2 days for delivery. The order must contain at least 12 units, supplied in cartons of 6.\nThe current daily spending budget is 250 cost-index units. Each purchased unit costs one cost-index unit."
    },
    {
      "key": "message_2",
      "text": "Current supplier agreement for decision day 0. All quantities are study units.\nSupplier | Carton size | Minimum order | Delivery days | Daily dispatch limit\nS1 | 2 | 4 | 1 | 100\nS2 | 4 | 8 | 2 | 120\nS3 | 6 | 12 | 2 | 150\nThe current daily spending budget is 250 cost-index units. Each purchased unit costs one cost-index unit."
    },
    {
      "key": "schema_supplier",
      "text": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"rules\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"supplier\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"S1\",\n              \"S2\",\n              \"S3\"\n            ]\n          },\n          \"pack\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          },\n          \"moq\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          },\n          \"lead_days\": {\n            \"type\": \"integer\",\n            \"minimum\": 1,\n            \"maximum\": 7\n          },\n          \"capacity\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          }\n        },\n        \"required\": [\n          \"supplier\",\n          \"pack\",\n          \"moq\",\n          \"lead_days\",\n          \"capacity\"\n        ],\n        \"additionalProperties\": false\n      },\n      \"minItems\": 3,\n      \"maxItems\": 3\n    },\n    \"budget\": {\n      \"type\": \"integer\",\n      \"minimum\": 1\n    }\n  },\n  \"required\": [\n    \"rules\",\n    \"budget\"\n  ],\n  \"additionalProperties\": false\n}"
    },
    {
