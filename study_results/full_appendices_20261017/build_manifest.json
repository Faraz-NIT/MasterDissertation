      "caption": "Thirty paired simulation seeds, with two weeks aggregated inside seed; 95% bootstrap intervals. The structured comparator uses the same numerical tool and current rules, isolating the model-assisted interpretation/routing layer."
    },
    {
      "key": "paired_cost",
      "number": "B.7",
      "path": "study_results/ollama_dissertation_20261012/figures/paired_cost.png",
      "sha256": "4708d89d379123e129bfa1dd83ee975d99e8b7c7c980ae0fbe8ae420dff86a6d",
      "caption": "Thirty paired simulation seeds, with two weeks aggregated inside seed; 95% bootstrap intervals. Cost changes are means of paired seed-relative percentages. The structured comparator uses the same numerical tool and current rules, isolating the model-assisted interpretation/routing layer."
    },
    {
      "key": "holds",
      "number": "B.8",
      "path": "study_results/ollama_dissertation_20261012/figures/holds.png",
      "sha256": "c1759b9b6df1ef6a0e569f0078ac0a8de7756d64d4d6f2b90dca8a1d561365b7",
      "caption": "A hold is an unexecuted decision, not a successful zero-order recommendation. The same deterministic budget, capacity, pack and minimum-order checks govern all arms."
    },
    {
      "key": "langchain_agent_extension",
      "number": "E.1",
      "path": "study_results/langchain_extension_20261014/figures/agent_extension.png",
