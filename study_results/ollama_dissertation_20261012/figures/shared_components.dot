digraph Thesis { graph [rankdir=LR,bgcolor="white",pad=.2,nodesep=.3,ranksep=.4,label="M5 + RetailNet — The comparison that isolates the LLM layer",labelloc=t,fontname="Arial",fontsize=18]; node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,color="#BDCBD4",fillcolor="#F2F6F9",margin=".15,.12"]; edge [color="#8194A2",arrowsize=.7]; a [label="Structured current inputs"]; b [label="Supplier text + LLM roles",fillcolor="#F3EDF7"]; c [label="Same numerical planner"]; d [label="Common execution limits"]; a -> c; b -> c; c -> d; }