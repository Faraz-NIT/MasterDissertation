digraph Thesis { graph [rankdir=LR,bgcolor="white",pad=.2,nodesep=.3,ranksep=.4,label="M5 + RetailNet — From information to an order",labelloc=t,fontname="Arial",fontsize=18]; node [shape=box,style="rounded,filled",fontname="Arial",fontsize=14,color="#BDCBD4",fillcolor="#F2F6F9",margin=".15,.12"]; edge [color="#8194A2",arrowsize=.7]; a [label="Current information"]; b [label="Expected sales"]; c [label="Order calculation"]; d [label="Release checks"]; e [label="Stock and service"]; a -> b -> c -> d -> e; }